<view class="page">
  <!-- 自定义登录 loading -->
  <loading-overlay visible="{{showLoginLoading}}" text="{{loginLoadingText}}" />

  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="custom-nav-content">
      <text class="custom-nav-title">有米拍事故</text>
    </view>
  </view>

  <!-- 顶部 Banner（黄色背景 + 文字 + 女生插画），图片已包含文字 -->
  <view class="banner-section" style="padding-top: {{navBarHeight}}px;">
    <image class="banner-bg" src="/images/apply/group_accident.png" mode="aspectFill" />
  </view>

  <!-- 白色主卡片（圆角上叠 Banner） -->
  <view class="main-card">

    <!-- 必备神器标题 -->
    <text class="section-title">必备神器</text>

    <!-- 两个卡片横向排列 -->
    <view class="action-cards-row">
      <!-- 录制视频卡片（推荐） -->
      <view class="action-card-small video-card" bindtap="goRecordVideo">
        <view class="recommend-badge">
          <image class="recommend-badge-bg" src="/images/apply/badge_recommend.png" mode="aspectFill" />
          <text class="recommend-badge-text">推荐</text>
        </view>
        <view class="icon-shimmer-wrap">
          <image class="action-card-small-icon" src="/images/apply/group_card_video.png" mode="aspectFit" />
        </view>
        <text class="action-card-small-label">录制事故视频</text>
      </view>

      <!-- 拍照上传卡片 -->
      <view class="action-card-small photo-card" bindtap="goTakePhoto">
        <image class="action-card-small-icon" src="/images/apply/group_card_photo.png" mode="aspectFit" />
        <text class="action-card-small-label">上传事故照片</text>
      </view>
    </view>

    <!-- 领取奖励按钮 -->
    <view class="bind-btn" bindtap="goUploadHistory">
      <text class="bind-btn-text">领取奖励</text>
    </view>

  </view>

  <!-- 手机号授权底部弹窗 -->
  <view class="phone-sheet-mask" wx:if="{{showPhoneModal}}" bindtap="closePhoneModal">
    <view class="phone-sheet" catchtap="">
      <view class="phone-sheet-bar"></view>
      <text class="phone-sheet-title">绑定手机号</text>
      <text class="phone-sheet-desc">绑定手机号后可正常领取奖励，我们承诺不会泄露您的信息</text>
      <button
        class="phone-sheet-btn"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
      >一键授权手机号</button>
      <view class="sheet-skip-btn" bindtap="closePhoneModal">暂不绑定</view>
    </view>
  </view>

  <!-- 福利官弹窗 -->
  <view class="modal-mask" wx:if="{{showWelfareModal}}" bindtap="closeWelfareModal">
    <view class="modal-content" catchtap="">
      <text class="modal-title">添加福利官微信</text>
      <image class="qrcode-img" src="/images/kefu.jpg" mode="widthFix" show-menu-by-longpress="{{true}}" />
      <text class="modal-hint">长按二维码识别添加福利官</text>
      <view class="modal-close" bindtap="closeWelfareModal">关闭</view>
    </view>
  </view>
</view>
